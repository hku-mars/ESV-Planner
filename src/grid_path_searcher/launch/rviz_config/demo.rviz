    Name: Time
    SyncMode: 0
    SyncSource: Grid_map
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 373
